# SQLite fallback if MySQL is not available
USE_SQLITE_FALLBACK=True

# Frontend URL for CORS
FRONTEND_URL=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000
