SECRET_KEY=django-insecure-healthy-future-super-secret-key-change-in-production
DEBUG=True

# Database Configuration (MySQL)
DB_NAME=healthy_future_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
